# UbuDesk server - systemd *user* unit.
# The portal screen-share dialog needs a live desktop session, so this must
# run as your user inside the graphical session, never system-wide.
#
# Install:  server/packaging/install.sh
# Manage:   systemctl --user (start|stop|status|enable) ubudesk

[Unit]
Description=UbuDesk second-monitor server
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/ubudesk/venv-bin/ubudesk serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
